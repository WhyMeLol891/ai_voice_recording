# Environment configuration (Contains sensitive API keys)
.env
.env.backup
.env.local

# Storage temporary files and logs
storage/temp/*
!storage/temp/.gitkeep
!storage/temp/.htaccess

storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess

# Uploads
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

